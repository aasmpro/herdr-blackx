{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "blackx-chrome"
          },
          "size": {
            "px": 32
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "blackx-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "blackx-tabs"
          },
          "size": {
            "px": 32
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "blackx-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 0,
                    "color": "border"
                  },
                  "focus": {
                    "width": 0,
                    "color": "border"
                  },
                  "radius": 0,
                  "gap": 1,
                  "lone": true
                }
              },
              "background": "border"
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "blackx-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "blackx-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 0
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "blackx-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "colors": {
    "accent": "#ffffff",
    "accent_foreground": "#000000",
    "background": "#000000",
    "blocked": "#ffffff",
    "border": "#303030",
    "canvas": "#000000",
    "chrome": "#000000",
    "dim": "#777777",
    "done": "#dddddd",
    "foreground": "#eeeeee",
    "hover": "#202020",
    "idle": "#777777",
    "input": "#606060",
    "muted": "#aaaaaa",
    "popover": "#101010",
    "raised": "#181818",
    "selected": "#282828",
    "selection": "#282828",
    "solid": "#eeeeee",
    "solid_foreground": "#000000",
    "surface": "#000000",
    "unknown": "#999999",
    "working": "#bbbbbb"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 0,
    "color": "border"
  },
  "resizable": true,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "blackx-menu",
  "font": "JetBrainsMono Nerd Font",
  "ui_font": "JetBrainsMono Nerd Font",
  "font_size": 13
}
